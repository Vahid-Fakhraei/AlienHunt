<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="@string/perfil_activo"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/cd_avatar"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtJugador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:textColor="@color/acid"
            android:textSize="28sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJugar"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:minWidth="220dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_jugar"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCambiarPerfil"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:minWidth="220dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_cambiar_perfil"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolverMenu"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:minWidth="220dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_volver_menu"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogout"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:minWidth="220dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/cerrar_sesion"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
