<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_alien_vs_predator" />

    <!-- Capa oscura para que el texto se lea bien sobre la imagen -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30D1117" />

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="@string/terminos_titulo"
            android:textColor="@color/acid"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="#CC1F2937"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/terminos_texto"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </ScrollView>

        <CheckBox
            android:id="@+id/chkAcepto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/acid"
            android:minHeight="48dp"
            android:text="@string/terminos_acepto"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAceptar"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.4"
            android:background="@drawable/bg_button"
            android:enabled="false"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_aceptar"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRechazar"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/btn_rechazar"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
